# Public URL only. Never put an OCR secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_BUSINESS_CARD_OCR_ENDPOINT=http://localhost:8787/ocr/business-card

# Server-side variables for tools/business-card-ocr-gateway.mjs
OCR_PROVIDER=clova
CLOVA_OCR_INVOKE_URL=https://YOUR-ID.apigw.ntruss.com/custom/v1/YOUR-DOMAIN/YOUR-KEY/document/name-card
CLOVA_OCR_SECRET=replace-on-server-only
OCR_ALLOWED_ORIGIN=http://localhost:3000
OCR_GATEWAY_PORT=8787
