datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AccountUser {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  personnelId     String         @unique
  status          String         @default("ACTIVE")
  sessionVersion  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  personnel       PersonnelCard  @relation(fields: [personnelId], references: [id])
}

model Session {
  id           String      @id @default(uuid())
  sid          String      @unique
  data         String
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model InviteToken {
  id           String      @id @default(uuid())
  tokenHash    String      @unique
  email        String
  role         String
  used         Boolean     @default(false)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
}

model PersonnelCard {
  id                 String       @id @default(uuid())
  employeeNumber     String?
  name               String
  displayName        String?
  koreanAlias        String?
  vietnameseName     String?
  email              String?
  phone              String?
  companyId          String?
  companyName        String?
  departmentId       String
  departmentName     String?
  subDepartmentId    String?
  subDepartmentName  String?
  teamId             String?
  teamName           String?
  role               String
  systemRole         String?
  permissionLevel    Int?
  organizationRank   String?
  employmentStatus   String?
  isActive           Boolean      @default(true)
  deputyApproverId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  account            AccountUser?
  managedProjects    Project[]    @relation("ManagerProjects")
  pmProjects         Project[]    @relation("PMProjects")
  tasks              Task[]       @relation("AssigneeTasks")
  assignments        ProcessTemplateAssignment[] @relation("PMAssignments")
  estimateRequests   EstimateRequest[] @relation("EstimateRequestOwner")
}

model Project {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  status      String
  managerId   String
  pmId        String
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager     PersonnelCard @relation("ManagerProjects", fields: [managerId], references: [id])
  pm          PersonnelCard @relation("PMProjects", fields: [pmId], references: [id])
  tasks       Task[]
  estimateRequest EstimateRequest?
  estimateDbRecords EstimateDbRecord[]
  commercialDecision CommercialDecision?
  projectIntake ProjectIntake?
  pmSchedule ProjectPmSchedule?
  operation ProjectOperation?
  qcChecklist ProjectQcChecklist?
  deliveryWorkspace ProjectDeliveryWorkspace?
}

model EstimateDbRecord {
  id             String   @id @default(uuid())
  idempotencyKey String?  @unique
  section        String
  projectId      String?
  sourceRecordId String?
  pjNo           String?
  year           Int?
  sortOrder      Int      @default(0)
  schemaVersion  Int      @default(1)
  dataJson       String   @db.Text
  version        Int      @default(1)
  createdBy      String
  updatedBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([section, sourceRecordId])
  @@index([section, year, sortOrder])
  @@index([projectId])
  @@index([pjNo])
}

model EstimateDbVendor {
  id              String   @id @default(uuid())
  normalizedName  String
  normalizedTrade String
  dataJson        String   @db.Text
  version         Int      @default(1)
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([normalizedName, normalizedTrade])
  @@index([normalizedTrade])
}

model EstimateDbMonthlyTarget {
  id        String   @id @default(uuid())
  type      String
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(18, 2)
  version   Int      @default(1)
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, year, month])
  @@index([year, type])
}
model EstimateRequest {
  id                String   @id @default(uuid())
  requestNo         String   @unique
  idempotencyKey    String?  @unique
  status            String   @default("REQUEST_MEMO")
  projectName       String
  company           String?
  client            String?
  contact           String?
  contactDepartment String?
  phone             String?
  email             String?
  ownerId           String?
  departmentId      String
  requestDate       DateTime @default(now())
  memo              String?  @db.Text
  rawMemo           String?  @db.Text
  firstDelivery     String?
  secondDelivery    String?
  thirdDelivery     String?
  finalDelivery     String?
  expectedStartDate String?
  areaPy            String?
  floors            String?
  scope             String?
  usage             String?
  buildingCount     String?
  unitWork          String?
  bidDate           String?
  estimateType      String?
  estimateId        String?
  projectId         String?  @unique
  version           Int      @default(1)
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner       PersonnelCard? @relation("EstimateRequestOwner", fields: [ownerId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  activities  EstimateRequestActivity[]
  attachments EstimateRequestAttachment[]
  histories   EstimateRequestHistory[]
  estimateSheet EstimateSheet?
  commercialDecisions CommercialDecision[]
  projectIntake ProjectIntake?

  @@index([departmentId, status])
  @@index([ownerId])
  @@index([createdAt])
}

model EstimateTemplate {
  id          String   @id @default(uuid())
  type        String   @unique
  sheetName   String
  version     Int      @default(1)
  sourceHash  String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sheets      EstimateSheet[]
}

model EstimateSheet {
  id                String   @id @default(uuid())
  estimateRequestId String   @unique
  templateId        String
  templateType      String
  status            String   @default("DRAFT")
  currentVersion    Int      @default(1)
  idempotencyKey    String?  @unique
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)
  template        EstimateTemplate @relation(fields: [templateId], references: [id])
  versions        EstimateSheetVersion[]
  exports         EstimateSheetExport[]
  submissions     EstimateSubmission[]
  commercialDecisions CommercialDecision[]

  @@index([templateType, status])
}

model EstimateSubmission {
  id              String    @id @default(uuid())
  estimateSheetId String
  version         Int
  status          String    @default("SUBMITTED")
  submittedAt     DateTime  @default(now())
  submittedBy     String
  sentAt          DateTime?
  sentBy          String?
  recipient       String?
  deliveryChannel String?
  documentHash    String
  summaryJson     String    @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  estimateSheet EstimateSheet @relation(fields: [estimateSheetId], references: [id], onDelete: Cascade)
  commercialDecisions CommercialDecision[]

  @@unique([estimateSheetId, version])
  @@index([status, submittedAt])
  @@index([sentAt])
}

model CommercialDecision {
  id                   String   @id @default(uuid())
  estimateRequestId    String
  estimateSheetId      String?
  estimateSubmissionId String?
  projectId            String?  @unique
  idempotencyKey       String   @unique
  decision             String
  reason               String?  @db.Text
  agreedAmount         Decimal? @db.Decimal(18, 2)
  agreedScope          String?  @db.Text
  agreedSchedule       String?  @db.Text
  startCondition       String?  @db.Text
  decidedAt            DateTime @default(now())
  decidedBy            String
  createdAt            DateTime @default(now())

  estimateRequest    EstimateRequest     @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)
  estimateSheet      EstimateSheet?      @relation(fields: [estimateSheetId], references: [id], onDelete: SetNull)
  estimateSubmission EstimateSubmission? @relation(fields: [estimateSubmissionId], references: [id], onDelete: SetNull)
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectIntake      ProjectIntake?

  @@index([estimateRequestId, decidedAt])
  @@index([decision, decidedAt])
}

model ProjectIntake {
  id                   String   @id @default(uuid())
  estimateRequestId    String   @unique
  commercialDecisionId String   @unique
  projectId            String   @unique
  status               String   @default("DRAFT")
  projectNo            String
  sourceSnapshotJson   String   @db.Text
  draftJson            String?  @db.Text
  reviewNote           String?  @db.Text
  reviewedBy           String?
  reviewedAt           DateTime?
  acceptedBy           String?
  acceptedAt           DateTime?
  version              Int      @default(1)
  createdBy            String
  updatedBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  estimateRequest    EstimateRequest    @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)
  commercialDecision CommercialDecision @relation(fields: [commercialDecisionId], references: [id], onDelete: Cascade)
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  histories          ProjectIntakeHistory[]

  @@index([status, updatedAt])
}

model ProjectIntakeHistory {
  id              String   @id @default(uuid())
  projectIntakeId String
  action          String
  fromStatus      String?
  toStatus        String?
  changesJson     String?  @db.Text
  actorId         String
  createdAt       DateTime @default(now())

  projectIntake ProjectIntake @relation(fields: [projectIntakeId], references: [id], onDelete: Cascade)

  @@index([projectIntakeId, createdAt])
}

model ProjectPmSchedule {
  id                 String   @id @default(uuid())
  projectId          String   @unique
  status             String   @default("PENDING_ASSIGNMENT")
  assignmentsJson    String   @db.Text
  requestTargetsJson String   @db.Text
  requestMemo        String?  @db.Text
  plan1Json          String   @db.Text
  plan2Json          String   @db.Text
  selectedProposal   String?
  approvedPlan       String?
  rejectReason       String?  @db.Text
  requestedBy        String?
  requestedAt        DateTime?
  submittedBy        String?
  submittedAt        DateTime?
  approvedBy         String?
  approvedAt         DateTime?
  version            Int      @default(1)
  createdBy          String
  updatedBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  histories ProjectPmScheduleHistory[]

  @@index([status, updatedAt])
}

model ProjectPmScheduleHistory {
  id                  String   @id @default(uuid())
  projectPmScheduleId String
  action              String
  fromStatus          String?
  toStatus            String?
  detailsJson         String?  @db.Text
  actorId             String
  createdAt           DateTime @default(now())

  projectPmSchedule ProjectPmSchedule @relation(fields: [projectPmScheduleId], references: [id], onDelete: Cascade)

  @@index([projectPmScheduleId, createdAt])
}

model ProjectOperation {
  id                     String   @id
  projectId              String   @unique
  awardDate              DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  startApprovalStatus    String   @default("PENDING")
  startApprovedBy        String?
  startApprovedAt        DateTime?
  version                Int      @default(1)
  createdBy              String
  updatedBy              String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project    Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities ProjectOperationActivity[]

  @@index([updatedAt])
}

model ProjectOperationActivity {
  id                 String   @id @default(uuid())
  projectOperationId String
  kind               String
  occurredAt         DateTime
  title              String
  body               String   @db.Text
  metadataJson       String?  @db.Text
  createdBy          String
  createdAt          DateTime @default(now())
  deletedBy          String?
  deletedAt          DateTime?

  projectOperation ProjectOperation @relation(fields: [projectOperationId], references: [id], onDelete: Cascade)

  @@index([projectOperationId, occurredAt])
  @@index([kind, occurredAt])
}

model ProjectQcChecklist {
  id        String   @id
  projectId String   @unique
  status    String   @default("OPEN")
  version   Int      @default(1)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items    ProjectQcItem[]
  histories ProjectQcHistory[]

  @@index([updatedAt])
}

model ProjectQcItem {
  id                 String   @id @default(uuid())
  projectQcChecklistId String
  group              String
  middleCategory     String?
  subCategory        String?
  trade              String
  serialNo           String
  item               String   @db.Text
  method             String   @db.Text
  targetsJson        String   @db.Text
  checksJson         String   @db.Text
  status             String   @default("PENDING")
  comment            String   @db.Text
  objectionJson      String?  @db.Text
  eliminated         Boolean  @default(false)
  sentAt             DateTime?
  sentBy             String?
  createdBy          String
  updatedBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedBy          String?
  deletedAt          DateTime?

  checklist  ProjectQcChecklist  @relation(fields: [projectQcChecklistId], references: [id], onDelete: Cascade)
  attachments ProjectQcAttachment[]
  histories   ProjectQcHistory[]

  @@index([projectQcChecklistId, group, serialNo])
  @@index([status, updatedAt])
}

model ProjectQcAttachment {
  id           String   @id @default(uuid())
  projectQcItemId String
  originalName String
  mimeType     String
  size         Int
  storageKey   String?
  checksum     String?
  createdBy    String
  createdAt    DateTime @default(now())
  deletedBy    String?
  deletedAt    DateTime?

  item ProjectQcItem @relation(fields: [projectQcItemId], references: [id], onDelete: Cascade)

  @@index([projectQcItemId, createdAt])
}

model ProjectQcHistory {
  id                 String   @id @default(uuid())
  projectQcChecklistId String
  projectQcItemId    String?
  action             String
  detailsJson        String?  @db.Text
  actorId            String
  createdAt          DateTime @default(now())

  checklist ProjectQcChecklist @relation(fields: [projectQcChecklistId], references: [id], onDelete: Cascade)
  item      ProjectQcItem?      @relation(fields: [projectQcItemId], references: [id], onDelete: SetNull)

  @@index([projectQcChecklistId, createdAt])
  @@index([projectQcItemId, createdAt])
}

model ProjectQcTerm {
  id         String   @id @default(uuid())
  term       String   @unique
  definition String   @db.Text
  createdBy  String
  updatedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([updatedAt])
}

model ProjectDeliveryWorkspace {
  id            String   @id
  projectId     String   @unique
  status        String   @default("OPEN")
  progressRate  Int      @default(0)
  currentStage  String?
  version       Int      @default(1)
  createdBy     String
  updatedBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rounds           ProjectDeliveryRound[]
  records          ProjectDeliveryRecord[]
  downloadRequests ProjectDownloadRequest[]
  dailyReports     ProjectDailyReport[]
  histories        ProjectDeliveryHistory[]

  @@index([status, updatedAt])
}

model ProjectDeliveryRound {
  id                         String   @id @default(uuid())
  projectDeliveryWorkspaceId String
  roundNo                    Int
  kind                       String   @default("DELIVERY")
  parentRoundId              String?
  label                      String
  deliveryDate               DateTime
  memo                       String   @db.Text
  status                     String   @default("REGISTERED")
  createdBy                  String
  createdAt                  DateTime @default(now())

  workspace ProjectDeliveryWorkspace @relation(fields: [projectDeliveryWorkspaceId], references: [id], onDelete: Cascade)
  files     ProjectDeliveryFile[]
  parentRound ProjectDeliveryRound?  @relation("DeliveryRoundRevisions", fields: [parentRoundId], references: [id], onDelete: SetNull)
  redeliveries ProjectDeliveryRound[] @relation("DeliveryRoundRevisions")

  @@unique([projectDeliveryWorkspaceId, roundNo])
  @@index([projectDeliveryWorkspaceId, deliveryDate])
  @@index([parentRoundId])
}

model ProjectDeliveryFile {
  id                     String   @id @default(uuid())
  projectDeliveryRoundId String
  logicalFileKey         String
  version                Int
  originalName           String
  mimeType               String
  size                   Int
  storageKey             String?
  checksum               String?
  memo                   String   @db.Text
  createdBy              String
  createdAt              DateTime @default(now())

  round ProjectDeliveryRound @relation(fields: [projectDeliveryRoundId], references: [id], onDelete: Cascade)

  @@unique([projectDeliveryRoundId, logicalFileKey, version])
  @@index([projectDeliveryRoundId, createdAt])
}

model ProjectDeliveryRecord {
  id                         String   @id @default(uuid())
  projectDeliveryWorkspaceId String
  occurredAt                 DateTime
  type                       String
  memo                       String   @db.Text
  writerId                   String
  createdAt                  DateTime @default(now())

  workspace ProjectDeliveryWorkspace @relation(fields: [projectDeliveryWorkspaceId], references: [id], onDelete: Cascade)

  @@index([projectDeliveryWorkspaceId, occurredAt])
}

model ProjectDownloadRequest {
  id                         String   @id @default(uuid())
  projectDeliveryWorkspaceId String
  targetFile                 String
  reason                     String   @db.Text
  status                     String   @default("PENDING")
  requestedBy                String
  requestedAt                DateTime @default(now())
  reviewedBy                 String?
  reviewedAt                 DateTime?
  reviewNote                 String?  @db.Text

  workspace ProjectDeliveryWorkspace @relation(fields: [projectDeliveryWorkspaceId], references: [id], onDelete: Cascade)

  @@index([projectDeliveryWorkspaceId, requestedAt])
  @@index([status, requestedAt])
}

model ProjectDailyReport {
  id                         String   @id @default(uuid())
  projectDeliveryWorkspaceId String
  scheduleRowId              String?
  reportDate                 DateTime
  stage                      String
  planMemo                   String   @db.Text
  resultMemo                 String   @db.Text
  progressRate               Int
  delayReason                String   @db.Text
  overtimeReason             String   @db.Text
  pmStatus                   String   @default("NOT_REQUIRED")
  managerStatus              String   @default("NOT_REQUIRED")
  executiveStatus            String   @default("NOT_REQUIRED")
  createdBy                  String
  updatedBy                  String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  workspace ProjectDeliveryWorkspace @relation(fields: [projectDeliveryWorkspaceId], references: [id], onDelete: Cascade)

  @@index([projectDeliveryWorkspaceId, reportDate])
  @@index([createdBy, reportDate])
}

model ProjectDeliveryHistory {
  id                         String   @id @default(uuid())
  projectDeliveryWorkspaceId String
  entityType                 String
  entityId                   String?
  action                     String
  detailsJson                String?  @db.Text
  actorId                    String
  createdAt                  DateTime @default(now())

  workspace ProjectDeliveryWorkspace @relation(fields: [projectDeliveryWorkspaceId], references: [id], onDelete: Cascade)

  @@index([projectDeliveryWorkspaceId, createdAt])
}

model EstimateSheetVersion {
  id              String   @id @default(uuid())
  estimateSheetId String
  version         Int
  templateVersion Int
  templateHash    String
  stateJson       String   @db.Text
  createdBy       String
  createdAt       DateTime @default(now())

  estimateSheet EstimateSheet @relation(fields: [estimateSheetId], references: [id], onDelete: Cascade)

  @@unique([estimateSheetId, version])
  @@index([estimateSheetId, createdAt])
}

model EstimateSheetExport {
  id              String   @id @default(uuid())
  estimateSheetId String
  version         Int
  format          String
  fileName        String
  actorId         String
  createdAt       DateTime @default(now())

  estimateSheet EstimateSheet @relation(fields: [estimateSheetId], references: [id], onDelete: Cascade)

  @@index([estimateSheetId, createdAt])
}

model EstimateRequestActivity {
  id                String   @id @default(uuid())
  estimateRequestId String
  kind              String
  content           String   @db.Text
  occurredAt        DateTime @default(now())
  createdBy         String
  createdAt         DateTime @default(now())

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  @@index([estimateRequestId, occurredAt])
}

model EstimateRequestAttachment {
  id                String   @id @default(uuid())
  estimateRequestId String
  category          String
  label             String
  originalName      String
  size              Int
  mimeType          String?
  memo              String?  @db.Text
  storageKey        String?
  status            String   @default("REGISTERED")
  createdBy         String
  createdAt         DateTime @default(now())

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  @@index([estimateRequestId, category])
}

model EstimateRequestHistory {
  id                String   @id @default(uuid())
  estimateRequestId String
  action            String
  fromStatus        String?
  toStatus          String?
  changes           String?  @db.Text
  actorId           String
  createdAt         DateTime @default(now())

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  @@index([estimateRequestId, createdAt])
}

model Task {
  id            String   @id @default(uuid())
  projectId     String
  title         String
  status        String
  priority      String
  departmentId  String
  startDate     DateTime
  dueDate       DateTime
  orderIndex    Int
  assigneeId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id])
  assignee      PersonnelCard? @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  workSegments  TaskWorkSegment[]
}

model TaskWorkSegment {
  id          String   @id @default(uuid())
  taskId      String
  workerId    String
  date        DateTime
  hours       Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id])
}

model ProcessTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  stages      ProcessStage[]
}

model ProcessStage {
  id          String   @id @default(uuid())
  templateId  String
  name        String
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template    ProcessTemplate @relation(fields: [templateId], references: [id])
  tasks       ProcessTask[]
}

model ProcessTask {
  id          String   @id @default(uuid())
  stageId     String
  name        String
  category    String
  orderIndex  Int
  isRequired  Boolean  @default(true)
  referenceAssignee String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stage       ProcessStage @relation(fields: [stageId], references: [id])
}

model ProcessTemplateAssignment {
  id              String   @id @default(uuid())
  taskId          String
  templateId      String
  status          String   @default("DRAFT")
  pmId            String
  managerId       String?
  revisionNo      Int      @default(1)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  historySnapshot String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pm              PersonnelCard @relation("PMAssignments", fields: [pmId], references: [id])
  schedules       ProcessSchedule[]
}

model ProcessSchedule {
  id             String   @id @default(uuid())
  assignmentId   String
  processStageId String
  processTaskId  String
  startDate      DateTime
  endDate        DateTime
  assigneeId     String?
  status         String
  progress       Int
  category       String
  isOfficial     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment     ProcessTemplateAssignment @relation(fields: [assignmentId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  actorId     String
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  message     String
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
}

model ImportRun {
  id          String   @id @default(uuid())
  importedBy  String
  records     Int
  status      String
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}
