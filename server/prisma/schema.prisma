datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AccountUser {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  personnelId     String         @unique
  status          String         @default("ACTIVE")
  sessionVersion  Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  personnel       PersonnelCard  @relation(fields: [personnelId], references: [id])
}

model Session {
  id           String      @id @default(uuid())
  sid          String      @unique
  data         String
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model InviteToken {
  id           String      @id @default(uuid())
  tokenHash    String      @unique
  email        String
  role         String
  used         Boolean     @default(false)
  expiresAt    DateTime
  createdAt    DateTime    @default(now())
}

model PersonnelCard {
  id                 String       @id @default(uuid())
  employeeNumber     String?
  name               String
  displayName        String?
  koreanAlias        String?
  vietnameseName     String?
  email              String?
  phone              String?
  companyId          String?
  companyName        String?
  departmentId       String
  departmentName     String?
  subDepartmentId    String?
  subDepartmentName  String?
  teamId             String?
  teamName           String?
  role               String
  systemRole         String?
  permissionLevel    Int?
  organizationRank   String?
  employmentStatus   String?
  isActive           Boolean      @default(true)
  deputyApproverId   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  account            AccountUser?
  managedProjects    Project[]    @relation("ManagerProjects")
  pmProjects         Project[]    @relation("PMProjects")
  tasks              Task[]       @relation("AssigneeTasks")
  assignments        ProcessTemplateAssignment[] @relation("PMAssignments")
  estimateRequests   EstimateRequest[] @relation("EstimateRequestOwner")
}

model Project {
  id          String   @id @default(uuid())
  companyId   String
  name        String
  status      String
  managerId   String
  pmId        String
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager     PersonnelCard @relation("ManagerProjects", fields: [managerId], references: [id])
  pm          PersonnelCard @relation("PMProjects", fields: [pmId], references: [id])
  tasks       Task[]
  estimateRequest EstimateRequest?
}

model EstimateRequest {
  id                String   @id @default(uuid())
  requestNo         String   @unique
  idempotencyKey    String?  @unique
  status            String   @default("REQUEST_MEMO")
  projectName       String
  company           String?
  client            String?
  contact           String?
  contactDepartment String?
  phone             String?
  email             String?
  ownerId           String?
  departmentId      String
  requestDate       DateTime @default(now())
  memo              String?  @db.Text
  rawMemo           String?  @db.Text
  firstDelivery     String?
  secondDelivery    String?
  thirdDelivery     String?
  finalDelivery     String?
  expectedStartDate String?
  areaPy            String?
  floors            String?
  scope             String?
  usage             String?
  buildingCount     String?
  unitWork          String?
  bidDate           String?
  estimateType      String?
  estimateId        String?
  projectId         String?  @unique
  version           Int      @default(1)
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner       PersonnelCard? @relation("EstimateRequestOwner", fields: [ownerId], references: [id])
  project     Project? @relation(fields: [projectId], references: [id])
  activities  EstimateRequestActivity[]
  attachments EstimateRequestAttachment[]
  histories   EstimateRequestHistory[]

  @@index([departmentId, status])
  @@index([ownerId])
  @@index([createdAt])
}

model EstimateRequestActivity {
  id                String   @id @default(uuid())
  estimateRequestId String
  kind              String
  content           String   @db.Text
  occurredAt        DateTime @default(now())
  createdBy         String
  createdAt         DateTime @default(now())

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  @@index([estimateRequestId, occurredAt])
}

model EstimateRequestAttachment {
  id                String   @id @default(uuid())
  estimateRequestId String
  category          String
  label             String
  originalName      String
  size              Int
  mimeType          String?
  memo              String?  @db.Text
  storageKey        String?
  status            String   @default("REGISTERED")
  createdBy         String
  createdAt         DateTime @default(now())

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  @@index([estimateRequestId, category])
}

model EstimateRequestHistory {
  id                String   @id @default(uuid())
  estimateRequestId String
  action            String
  fromStatus        String?
  toStatus          String?
  changes           String?  @db.Text
  actorId           String
  createdAt         DateTime @default(now())

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  @@index([estimateRequestId, createdAt])
}

model Task {
  id            String   @id @default(uuid())
  projectId     String
  title         String
  status        String
  priority      String
  departmentId  String
  startDate     DateTime
  dueDate       DateTime
  orderIndex    Int
  assigneeId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id])
  assignee      PersonnelCard? @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  workSegments  TaskWorkSegment[]
}

model TaskWorkSegment {
  id          String   @id @default(uuid())
  taskId      String
  workerId    String
  date        DateTime
  hours       Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id])
}

model ProcessTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  stages      ProcessStage[]
}

model ProcessStage {
  id          String   @id @default(uuid())
  templateId  String
  name        String
  orderIndex  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template    ProcessTemplate @relation(fields: [templateId], references: [id])
  tasks       ProcessTask[]
}

model ProcessTask {
  id          String   @id @default(uuid())
  stageId     String
  name        String
  category    String
  orderIndex  Int
  isRequired  Boolean  @default(true)
  referenceAssignee String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stage       ProcessStage @relation(fields: [stageId], references: [id])
}

model ProcessTemplateAssignment {
  id              String   @id @default(uuid())
  taskId          String
  templateId      String
  status          String   @default("DRAFT")
  pmId            String
  managerId       String?
  revisionNo      Int      @default(1)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  historySnapshot String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pm              PersonnelCard @relation("PMAssignments", fields: [pmId], references: [id])
  schedules       ProcessSchedule[]
}

model ProcessSchedule {
  id             String   @id @default(uuid())
  assignmentId   String
  processStageId String
  processTaskId  String
  startDate      DateTime
  endDate        DateTime
  assigneeId     String?
  status         String
  progress       Int
  category       String
  isOfficial     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment     ProcessTemplateAssignment @relation(fields: [assignmentId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  actorId     String
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  message     String
  isRead      Boolean  @default(false)
  link        String?
  createdAt   DateTime @default(now())
}

model ImportRun {
  id          String   @id @default(uuid())
  importedBy  String
  records     Int
  status      String
  details     String?  @db.Text
  createdAt   DateTime @default(now())
}
